# Domain for TLS certificates (Caddy)
DOMAIN=article.example.org
# Database password
POSTGRES_PASSWORD=change-me-long-random
# Token between API/worker and the sandbox service
SANDBOX_TOKEN=change-me-long-random
# Master key for encryption at rest (32 bytes, base64). Generate:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Store it in a secrets manager and back it up: without it, project data cannot be decrypted.
AI_ARTICLE_MASTER_KEY=
# Claude API (provider with zero data retention per contract, NFR-3)
ANTHROPIC_API_KEY=
# Registration: open | closed (the first user becomes administrator)
AI_ARTICLE_REGISTRATION=closed
# Contact for PubMed/Crossref/Unpaywall (enables open-access PDF lookup)
AI_ARTICLE_CONTACT_EMAIL=
NCBI_API_KEY=
